# -------------------------------
# Core LLM
# -------------------------------
MODEL_NAME="gemini-2.5-flash"
GEMINI_API_KEY="your-gemini-api-key"

# -------------------------------
# Google Cloud APIs (shared key)
# -------------------------------
# Required for live integrations. A single Google Cloud API key requires the following APIs enabled:
# 1. Places API (New)
# 2. Directions API
# 3. Maps JavaScript API
# 4. Cloud Text-to-Speech API
GOOGLE_CLOUD_API_KEY="your-google-cloud-api-key"
VITE_GOOGLE_CLOUD_API_KEY="your-google-cloud-api-key"
VITE_GOOGLE_MAPS_MAP_ID="your-map-id"
GCS_BUCKET_NAME="your-gcs-bucket-name"
GCS_SIGNED_URL_TTL_SECONDS="3600"
GOOGLE_APPLICATION_CREDENTIALS="/absolute/path/to/service-account.json"

# -------------------------------
# API / Frontend integration
# -------------------------------
ALLOWED_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"
