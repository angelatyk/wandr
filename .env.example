# -------------------------------
# Core LLM
# -------------------------------
MODEL_NAME="gemini-2.5-flash"
GEMINI_API_KEY="your-gemini-api-key"

# -------------------------------
# Maps / Places / Routing
# -------------------------------
GOOGLE_PLACES_API_KEY="your-places-api-key"
GOOGLE_MAPS_API_KEY="your-maps-api-key"

# Optional aliases/fallbacks used by the backend when GOOGLE_MAPS_API_KEY is unset
# GOOGLE_ROUTES_API_KEY="your-routes-api-key"
# GOOGLE_DIRECTIONS_API_KEY="your-directions-api-key"
# GGOGLE_DIRECTION_API_KEY="your-directions-api-key-legacy-typo"
# GOOGLE_JS_API_KEY="your-browser-maps-key"
# VITE_GOOGLE_MAPS_API_KEY="your-browser-maps-key"

# -------------------------------
# TTS + Audio storage
# -------------------------------
GOOGLE_TTS_API_KEY="your-tts-api-key"
GCS_BUCKET_NAME="your-gcs-bucket-name"
GCS_SIGNED_URL_TTL_SECONDS="3600"
GOOGLE_APPLICATION_CREDENTIALS="/absolute/path/to/service-account.json"

# -------------------------------
# API / Frontend integration
# -------------------------------
ALLOWED_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"
