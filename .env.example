# -------------------------------
# Core LLM
# -------------------------------
MODEL_NAME="gemini-2.5-flash"
# Optional comma-separated failover models used only on quota/rate-limit errors.
# MODEL_FALLBACKS="gemini-2.5-flash-lite,gemini-2.0-flash"
GEMINI_API_KEY="your-gemini-api-key"

# -------------------------------
# Google Cloud APIs (shared key)
# -------------------------------
# Required for live integrations. A single Google Cloud API key requires the following APIs enabled:
# 1. Places API (New)
# 2. Directions API
# 3. Maps JavaScript API
# 4. Cloud Text-to-Speech API
GOOGLE_CLOUD_API_KEY="your-google-cloud-api-key"
VITE_GOOGLE_CLOUD_API_KEY="your-google-cloud-api-key"
VITE_GOOGLE_MAPS_MAP_ID="your-map-id"
GCS_BUCKET_NAME="your-gcs-bucket-name"
GCS_SIGNED_URL_TTL_SECONDS="3600"
GOOGLE_APPLICATION_CREDENTIALS="/absolute/path/to/service-account.json"
# Use inline MP3 data URLs locally; set false + real bucket for signed GCS URLs.
TTS_PREFER_INLINE=true

# -------------------------------
# API / Frontend integration
# -------------------------------
ALLOWED_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# -------------------------------
# Auth / sessions
# -------------------------------
# Google OAuth client ID (from Google Cloud Console → Credentials → OAuth client,
# type "Web application"). Used to verify "Sign in with Google" ID tokens.
GOOGLE_OAUTH_CLIENT_ID="your-oauth-client-id.apps.googleusercontent.com"
# Long random string used to sign session cookies (e.g. `openssl rand -hex 32`).
# REQUIRED once auth is enabled — a weak/empty key means forgeable sessions.
SESSION_SECRET_KEY="change-me-to-a-long-random-value"
SESSION_COOKIE_NAME="wandr_session"
SESSION_TTL_SECONDS="604800"
# Set true behind HTTPS in production. When true, the local dev-login is disabled.
SESSION_COOKIE_SECURE=false
# Local convenience login. Automatically refused when SESSION_COOKIE_SECURE=true.
DEV_AUTH_ENABLED=true
