GEMINI_API_KEY="your-gemini-api-key"
MODEL_NAME="gemini-2.5-flash"

# Optional — only needed when moving off mock tools
GOOGLE_PLACES_API_KEY="your-places-api-key"
GOOGLE_MAPS_API_KEY="your-maps-api-key"
# Back-compat alias if you already created a browser maps key with this name
# (backend will fall back to it if GOOGLE_MAPS_API_KEY is unset)
# GOOGLE_JS_API_KEY="your-maps-key"
GOOGLE_TTS_API_KEY="your-tts-api-key"
GCS_BUCKET_NAME="your-gcs-bucket-name"
GCS_SIGNED_URL_TTL_SECONDS="3600"
GOOGLE_APPLICATION_CREDENTIALS="/absolute/path/to/service-account.json"

# Comma-separated CORS origins (defaults to Vite dev server)
ALLOWED_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"
